{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "rootDir": "themes/src",
    "outDir": "themes/dist",
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["themes/src"]
}
